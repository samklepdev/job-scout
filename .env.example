# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5434/job-scout-db-5434
# Optional: a separate, throwaway database for `npm test` (DB tests delete rows)
TEST_DATABASE_URL=

# Needed for resume tailoring
ANTHROPIC_API_KEY=
# Optional: defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: protects POST /api/ingest (for cron). Send as "Authorization: Bearer <secret>"
CRON_SECRET=
